# admin-api — copy to .env.local for local dev (that file is gitignored, never commit it).

# Single static admin password checked in POST /api/login. Never hardcode the
# real value anywhere in source — this env var is the only place it lives.
ADMIN_PASSWORD=

# Secret key used to HMAC-sign session bearer tokens issued by /api/login.
# Any long random string; rotating it invalidates all outstanding tokens.
ADMIN_SESSION_SECRET=

# Exact origin (scheme + host [+ port]) of the admin frontend allowed to call
# this API, e.g. https://admin.example.com or http://localhost:5173 for local
# dev. Echoed back as Access-Control-Allow-Origin on every response.
ADMIN_ALLOWED_ORIGIN=

# Supabase project REST URL. Local dev (via `npx supabase start` in backend/):
# http://127.0.0.1:54321
SUPABASE_URL=

# Supabase service_role-equivalent secret key — bypasses RLS entirely. This
# backend is the ONLY thing that should hold this key. Get the local dev value
# by running `npx supabase status` from backend/ (the "service_role key" line).
SUPABASE_SECRET_KEY=
