{
  "name": "beanweirdo",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "packages/*"
  ],
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript-eslint": "^8.70.0",
    "vitest": "^2.1.8"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p frontend/tsconfig.json && tsc --noEmit -p packages/post-renderer/tsconfig.json && tsc --noEmit -p backend/tsconfig.json",
    "test:unit": "vitest run",
    "test": "npm run lint && npm run typecheck && vitest run"
  }
}
