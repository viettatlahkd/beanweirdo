# Copy this file to .env.local (gitignored) and fill in real values from your
# Supabase project — Project Settings → API. The anon key is safe to expose in
# frontend code; Row Level Security in backend/supabase/schema.sql is what
# actually protects personal data, not keeping this key secret.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Base URL of the admin-api backend (see backend/) that powers the
# password-gated /admin section of this app. Local dev default matches
# backend's local dev port (3001); in production this is the deployed
# backend's URL.
VITE_ADMIN_API_URL=http://localhost:3001
