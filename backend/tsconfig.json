{
  "compilerOptions": {
    "target": "ES2021",
    "lib": ["ES2021"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowJs": false,
    "types": ["node"],
    // Types only: every import of it is `import type`, erased before the
    // functions are bundled, so the backend deploy never needs the package.
    "paths": { "api-contract": ["../packages/api-contract/src/index.ts"] }
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
